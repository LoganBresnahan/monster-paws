{
  "ckpt":       { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" } },
  "clipvision": { "class_type": "CLIPVisionLoader", "inputs": { "clip_name": "CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors" } },
  "ipa_model":  { "class_type": "IPAdapterModelLoader", "inputs": { "ipadapter_file": "ip-adapter-plus_sdxl_vit-h.safetensors" } },
  "img":        { "class_type": "LoadImage", "inputs": { "image": "" } },
  "ipa":        { "class_type": "IPAdapterAdvanced", "inputs": {
      "model": ["ckpt", 0], "ipadapter": ["ipa_model", 0], "image": ["img", 0], "clip_vision": ["clipvision", 0],
      "weight": 0.8, "weight_type": "linear", "combine_embeds": "concat",
      "start_at": 0.0, "end_at": 1.0, "embeds_scaling": "V only" } },
  "pos":        { "class_type": "CLIPTextEncode", "inputs": { "clip": ["ckpt", 1], "text": "" } },
  "neg":        { "class_type": "CLIPTextEncode", "inputs": { "clip": ["ckpt", 1], "text": "" } },
  "latent":     { "class_type": "EmptyLatentImage", "inputs": { "width": 1024, "height": 1024, "batch_size": 1 } },
  "sampler":    { "class_type": "KSampler", "inputs": {
      "model": ["ipa", 0], "positive": ["pos", 0], "negative": ["neg", 0], "latent_image": ["latent", 0],
      "seed": 0, "steps": 25, "cfg": 6.0, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1.0 } },
  "decode":     { "class_type": "VAEDecode", "inputs": { "samples": ["sampler", 0], "vae": ["ckpt", 2] } },
  "save":       { "class_type": "SaveImage", "inputs": { "images": ["decode", 0], "filename_prefix": "monsterpaws/ipadapter-v0" } }
}
