# Local dev (docker-compose.dev.yml)
DATABASE_URL=postgres://monsterpaws:monsterpaws@localhost:5432/monsterpaws

# Filled in as features land:
# EVERYORG_API_KEY=        # roadmap item 4
# RESCUEGROUPS_API_KEY=    # roadmap item 2 — granted 2026-08-02; `pass show rescuegroups/api-key`
#                          # unset = the ingest.poll job simply isn't registered.
#                          # A WRONG key is NOT detectable: the API returns 200 for
#                          # any non-empty Authorization header (verified 2026-08-17).
# REPLICATE_API_TOKEN=     # roadmap item 4 (internal-only until consent, ADR-0006)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_CORPUS_BUCKET=monsterpaws-corpus   # roadmap item 2 — scraped HTML vault (ADR-0011)
# The keys above are the WORKER credential: corpus + media only. Backups use a
# separate vault-only key — never give the worker one credential for both.
# R2_VAULT_ACCESS_KEY_ID=
# R2_VAULT_SECRET_ACCESS_KEY=
