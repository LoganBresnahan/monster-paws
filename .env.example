# Local dev (docker-compose.dev.yml)
DATABASE_URL=postgres://monsterpaws:monsterpaws@localhost:5432/monsterpaws
# Tests never read DATABASE_URL — they truncate, and the dev corpus is not theirs
# to empty (ADR-0017). Unset, this defaults to the _test database below, which
# `npm test` creates and migrates. SKIP_DB_TESTS=1 runs only the unit suites.
TEST_DATABASE_URL=postgres://monsterpaws:monsterpaws@localhost:5432/monsterpaws_test

# Filled in as features land:
# Every.org partner webhook (roadmap item 4, ADR-0027) — staging values in dev:
# `pass show everyorg/staging-webhook-token` etc.; production has its own three.
# EVERYORG_WEBHOOK_TOKEN=  # the donate link's webhook_token — visible to donors
# EVERYORG_AUTH_TOKEN=     # shown with the webhook; its use is asked of Every.org
# EVERYORG_WEBHOOK_SECRET= # our path segment on the webhook URL (ADR-0027 §4)
# WEBHOOK_SPOOL_DIR=       # where the webhook writes what the database can't take; only production's compose sets it (ADR-0027 as amended 2026-11-03)
# EVERYORG_ENV=staging     # staging | production: which Every.org a donate link leaves for.
#                          # Unset hides every Sponsor button, never a default host.
# SITE_ORIGIN=                # where Every.org sends a donor back, https://monsterpaws.org when unset.
#                          # Never http://localhost: Every.org ignores it and shows another charity's page.
# Shelter outreach (ADR-0029). Mail goes to Mailpit (docker-compose.dev.yml)
# unless the CLI is run with --live, which reads the Gmail pair instead.
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAILPIT_API_URL=http://localhost:8025
# The painting email (ADR-0027 as amended 2026-11-02, ADR-0035). Mailpit unless EMAIL_LIVE=1.
# EMAIL_SUPPRESSION_KEY=   # keyed HMAC for the never-mail list: `pass show resend/suppression-hmac-key`; unset, nothing is sent
# EMAIL_LINK_ORIGIN=       # the email's Share and Unsubscribe links, https://monsterpaws.org when unset
# EMAIL_SWEEP=on           # the worker sends owed paintings each minute; on the droplet only from oplog 0029's first real send
# EMAIL_LIVE=1             # real Resend to the one address below; `production` is the droplet's, to anyone
# RESEND_API_KEY=          # `pass show resend/api-key`; never filled by env:dev
# EMAIL_LIVE_ALLOWED_TO=   # the one exact address EMAIL_LIVE=1 may mail
# EMAIL_ART_SOURCE=        # store (ART_STORE_DIR) or media (SHARE_BASE_URL, by token)
# EMAIL_SHARE_LINKS=off    # leaves the Share button out, for a rehearsal with no published page
# RESEND_WEBHOOK_SECRET=   # `pass show resend/webhook-signing-secret`; unset, /api/webhooks/resend answers 404
# GMAIL_USER=              # the sending address, Logan's — `pass show google/gmail-user`
# GMAIL_APP_PASSWORD=      # `pass show google/gmail-app-password`; live sends only
# OUTREACH_SENDER_NAME=    # who signs the ask (default: Logan Bresnahan, founder); the address is GMAIL_USER
# OUTREACH_SENDER_ROLE=
# EVERYORG_API_KEY=        # nonprofit lookup by EIN (ADR-0029 §2) — `pass show everyorg/api-key`
# RESCUEGROUPS_API_KEY=    # roadmap item 2 — granted 2026-08-02; `pass show rescuegroups/api-key`
#                          # unset = the ingest.poll job simply isn't registered.
#                          # A WRONG key is NOT detectable: the API returns 200 for
#                          # any non-empty Authorization header (verified 2026-08-17).
# INGEST_POLL_SCHEDULE=off # prod .env until RescueGroups allowlists the droplet: the
#                          # worker unschedules ingest.poll and the bridge polls
#                          # (ADR-0033 as amended 2026-10-28); unset = scheduled.
# REPLICATE_API_TOKEN=     # roadmap item 4 (internal-only until consent, ADR-0006)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_CORPUS_BUCKET=monsterpaws-corpus   # roadmap item 2 — scraped HTML vault (ADR-0011)
# The keys above are the WORKER credential: corpus + media only. Backups use a
# separate vault-only key — never give the worker one credential for both. On
# the droplet the vault key lives in .env.backup, NEVER here: compose hands
# this file to the worker (scripts/backup-db.sh, ADR-0003 as amended 2026-10-26).
# R2_VAULT_ACCESS_KEY_ID=
# R2_VAULT_SECRET_ACCESS_KEY=

# Share pages (ADR-0036): the base URL that holds share/<token>/, in production
# https://media.monsterpaws.org. Unset, every share page is a 404. For a look in dev: `npx tsx e2e/share-fixture.ts 3198` and
# SHARE_BASE_URL=http://127.0.0.1:3198. The write keys are for `npm run share`
# only, on a machine with `pass` unlocked; they never go on the droplet.
# SHARE_BASE_URL=
# SHARE_WRITE_ENDPOINT=
# SHARE_WRITE_ACCESS_KEY_ID=
# SHARE_WRITE_SECRET_ACCESS_KEY=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_PURGE_TOKEN=

# Error reporting + poll heartbeat (ADR-0010 as amended) — prod only; unset in
# dev and CI so nothing reports. Values: `pass show betterstack/errors-dsn`,
# `pass show betterstack/heartbeat-ingest-poll`.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# HEARTBEAT_INGEST_POLL_URL=
# IMAGE_TAG=<sha>          # prod .env only: the image compose runs (oplog 0002)

# The local demo chain (doc/plans/demo-chain-contract.md). Never on the droplet.
# ART_SWEEP=on             # the worker's crew-only keepsake sweep
# ART_STORE_DIR=           # absolute: where art files live, shared by the painter and the mail
